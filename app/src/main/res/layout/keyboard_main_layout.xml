<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardRootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/keyboard_glass_panel_bg">

    <!-- Keyboard Toolbar -->
    <LinearLayout
        android:id="@+id/keyboardToolbar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:orientation="horizontal"
        android:background="#20FFFFFF">

        <!-- AI Menu Button with Status Light -->
        <LinearLayout
            android:id="@+id/btnToggleAiPanel"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/pill_button_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_ai_sparkle"
                android:contentDescription="AI Menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="AI"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Real Connection Status Light -->
            <View
                android:id="@+id/statusIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/status_indicator_shape" />
        </LinearLayout>

        <!-- Dynamic Middle Area: Suggestions Strip -->
        <LinearLayout
            android:id="@+id/suggestionStrip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:id="@+id/suggestion1"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/pill_button_glass"
                android:gravity="center"
                android:layout_marginHorizontal="2dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/suggestion2"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/pill_button_glass"
                android:gravity="center"
                android:layout_marginHorizontal="2dp"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/suggestion3"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/pill_button_glass"
                android:gravity="center"
                android:layout_marginHorizontal="2dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Code Mode Button -->
        <ImageButton
            android:id="@+id/btnToggleCodeToolbar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_code"
            android:contentDescription="Code tools"
            android:tint="#00E5FF" />

        <!-- Microphone (Voice Typing) Button -->
        <ImageButton
            android:id="@+id/btnVoiceTyping"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_mic"
            android:contentDescription="Voice typing"
            android:tint="#FFFFFF" />

        <!-- Settings Shortcut -->
        <ImageButton
            android:id="@+id/btnOpenSettingsShortcut"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings"
            android:tint="#94A3B8" />
    </LinearLayout>

    <!-- Coding Toolbar (Collapsible) -->
    <HorizontalScrollView
        android:id="@+id/codeToolbar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#151A26"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btnTermuxPrepare"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Termux Prep"
                android:textSize="11sp"
                android:textColor="#00E5FF"
                android:background="@drawable/pill_button_glass"
                android:paddingHorizontal="8dp" />

            <TextView
                android:id="@+id/codeSymCurlOpen"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="{"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/pill_button_glass"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/codeSymCurlClose"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="}"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/pill_button_glass"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/codeSymParenOpen"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="("
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/pill_button_glass"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/codeSymParenClose"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text=")"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/pill_button_glass"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/codeSymBracketOpen"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="["
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/pill_button_glass"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/codeSymBracketClose"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="]"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/pill_button_glass"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/codeSymArrow"
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="->"
                android:textColor="#00E5FF"
                android:textStyle="bold"
                android:background="@drawable/pill_button_glass"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/codeSymEquals"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="=="
                android:textColor="#00E5FF"
                android:textStyle="bold"
                android:background="@drawable/pill_button_glass"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/codeSymSemi"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text=";"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/pill_button_glass"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Collapsible AI Panel Drawer -->
    <LinearLayout
        android:id="@+id/aiCollapsiblePanel"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:orientation="vertical"
        android:background="#1B2232"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Top Input Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etAiInputPrompt"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#121824"
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13sp"
                android:hint="@string/ai_prompt_hint"
                android:inputType="text" />

            <Button
                android:id="@+id/btnSendAiPrompt"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:text="Ask"
                android:textSize="12sp"
                android:backgroundTint="#7C4DFF"
                android:textColor="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnCloseAiPanel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_backspace"
                android:tint="#94A3B8"
                android:contentDescription="Close AI Panel" />
        </LinearLayout>

        <!-- Action Chips (Horizontal Scroll) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipCorrect"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="@string/action_correct"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/pill_button_glass"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipRewrite"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="@string/action_rewrite"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/pill_button_glass"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipTranslate"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="@string/action_translate"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/pill_button_glass"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipSummarize"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="@string/action_summarize"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/pill_button_glass"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipExplain"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="@string/action_explain"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/pill_button_glass"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipFixCode"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="@string/action_fix_code"
                    android:textSize="11sp"
                    android:textColor="#00E5FF"
                    android:background="@drawable/pill_button_glass"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipUnitTests"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="@string/action_generate_tests"
                    android:textSize="11sp"
                    android:textColor="#00E5FF"
                    android:background="@drawable/pill_button_glass" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Response & Review Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:background="#121824"
            android:padding="8dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvAiResponseReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select text in editor or type a prompt above, then choose an AI action."
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
            </ScrollView>

            <ProgressBar
                android:id="@+id/pbAiLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Confirmation & Insertion Controls (Never auto-replaces!) -->
        <LinearLayout
            android:id="@+id/aiActionConfirmationRow"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnApplyToEditor"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="@string/btn_apply_to_editor"
                android:textSize="11sp"
                android:backgroundTint="#00E676"
                android:textColor="#000000"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnReplaceSelection"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="@string/btn_replace_selection"
                android:textSize="11sp"
                android:backgroundTint="#7C4DFF"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnCopyResponse"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="@string/btn_copy_response"
                android:textSize="11sp"
                android:backgroundTint="#242E42"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Custom Native Glass Keyboard View Container -->
    <com.smartkeyboard.aimenu.keyboard.KeyboardView
        android:id="@+id/customKeyboardView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keyboard_default_height"
        android:background="@android:color/transparent" />

</LinearLayout>

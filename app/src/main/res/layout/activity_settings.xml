<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D111A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Appearance Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_group_appearance"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/key_glass_selector_dark"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pref_theme"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerTheme"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pref_height"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />

            <Spinner
                android:id="@+id/spinnerHeight"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#FFFFFF" />
        </LinearLayout>

        <!-- Feedback Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_group_feedback"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/key_glass_selector_dark"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/cbVibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_vibration"
                android:textColor="#FFFFFF" />

            <CheckBox
                android:id="@+id/cbSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_sound"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Smart Typing Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_group_typing"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/key_glass_selector_dark"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/cbSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_suggestions"
                android:textColor="#FFFFFF" />

            <CheckBox
                android:id="@+id/cbAutocorrect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_autocorrect"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />

            <CheckBox
                android:id="@+id/cbAutoCaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_auto_caps"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- AI & MCP Navigation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_group_ai"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAiSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_configure_ai"
            android:backgroundTint="#7C4DFF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnMcpSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_configure_mcp"
            android:backgroundTint="#00B4D8"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>

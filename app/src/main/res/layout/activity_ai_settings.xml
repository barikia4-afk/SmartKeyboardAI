<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D111A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_ai_settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cbAiEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_enabled_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/key_glass_selector_dark"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_provider_label"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerProvider"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_model_label"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etModelId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#151D2C"
                android:textColor="#FFFFFF"
                android:textColorHint="#54657E"
                android:hint="e.g. gemini-1.5-flash or gpt-4o-mini"
                android:paddingHorizontal="12dp"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_endpoint_label"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etEndpoint"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#151D2C"
                android:textColor="#FFFFFF"
                android:textColorHint="#54657E"
                android:hint="https://generativelanguage.googleapis.com"
                android:paddingHorizontal="12dp"
                android:inputType="textUri" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_key_label"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#151D2C"
                android:textColor="#FFFFFF"
                android:textColorHint="#54657E"
                android:hint="Encrypted via Keystore"
                android:paddingHorizontal="12dp"
                android:inputType="textPassword" />
        </LinearLayout>

        <!-- Live Connection Status Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/keyboard_glass_panel_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/viewStatusLight"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/status_indicator_shape"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvStatusExplanation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_checking"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTestConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_test_connection"
            android:backgroundTint="#7C4DFF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnDeleteCredentials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_delete_credentials"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>

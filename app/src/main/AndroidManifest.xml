<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions required strictly for declared features -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_ai_sparkle"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_ai_sparkle"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartKeyboardAIMenu">

        <!-- Launcher & Onboarding Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartKeyboardAIMenu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Companion Settings Activities -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AiSettingsActivity"
            android:exported="false"
            android:label="@string/title_ai_settings"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".McpSettingsActivity"
            android:exported="false"
            android:label="@string/title_mcp_settings"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".PrivacyActivity"
            android:exported="false"
            android:label="@string/title_privacy"
            android:parentActivityName=".SettingsActivity" />

        <!-- Native Android InputMethodService -->
        <service
            android:name=".SmartKeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
